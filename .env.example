# Copy to apps/api/.dev.vars and apps/worker/.dev.vars as needed.
# Never commit real values. Production uses `wrangler secret put`.

# --- App / domains (purchased 4 Sep 2026) ---
# Mothership: safezoneready.com (canonical apex). www 301s to apex.
# Meta satellite: metasafezone.com 301s to https://safezoneready.com/?platform=meta
#   Do not put metasafezone.com in APP_ORIGIN, CORS, OAuth, Stripe, or Turnstile.
# Other satellites are not purchased.
ENVIRONMENT=local
APP_ORIGIN=http://127.0.0.1:43173
# Production: APP_ORIGIN=https://safezoneready.com
# Staging:    APP_ORIGIN=https://staging.safezoneready.com
API_PUBLIC_URL=http://127.0.0.1:8787
# Production: API_PUBLIC_URL=https://safezoneready.com
PUBLIC_APP_ORIGIN=http://127.0.0.1:43173
VITE_API_URL=http://127.0.0.1:8787
# Production Pages: VITE_API_URL=https://safezoneready.com  (same-origin /api)
VITE_TURNSTILE_SITE_KEY=
VITE_POSTERLY_URL=https://poster.ly

# --- Kill switch and caps ---
FIXES_ENABLED=true
TURNSTILE_BYPASS=1
DAILY_GEMINI_CAP=200
BURN_ALERT_USD=50
GLOBAL_FIX_CONCURRENCY=20
ASSET_TTL_HOURS=24
ALLOW_UNVERIFIED_DOWNLOAD=false

# --- Gemini (Worker only; never VITE_) ---
GEMINI_API_KEY=
GEMINI_MODEL_PRIMARY=gemini-3.1-flash-image
GEMINI_MODEL_ESCALATION=gemini-3-pro-image
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/interactions

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe (test mode until launch). Prefer a restricted key (rk_test_ / rk_live_). ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STUDIO=
STRIPE_STARTER_CREDITS=20
STRIPE_STUDIO_CREDITS=80

# --- Cloudflare Turnstile ---
TURNSTILE_SECRET_KEY=

# --- Sessions and hashing ---
SESSION_SECRET=
IP_HASH_SECRET=

# --- Optional later ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
